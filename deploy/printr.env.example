# Configuration du service printr (/etc/printr.env, root:printr, droits 660 : modifiable sans sudo par le groupe printr).

# Langue de l'appli et des tickets / Language of the app and tickets: fr (défaut) ou en.
#PRINTR_LANG=en

# Jeton optionnel pour les scripts (Authorization: Bearer ...), en plus des comptes de
# l'interface web. Pour en générer un : openssl rand -hex 24
#PRINTR_TOKEN=

# Barnum, pour le bloc « Horoscope » hors ligne (https://github.com/XNinety9/Barnum) :
#   sudo git clone https://github.com/XNinety9/Barnum /opt/barnum
PRINTR_BARNUM="python3 /opt/barnum/main.py"

# Un ticket sur 20 reçoit un message « glitch » de la machine (0 : jamais).
#PRINTR_GLITCH=20

# Clé API Claude, pour les blocs horoscope et word_of_the_day.
ANTHROPIC_API_KEY=
# Sans clé : la CLI Claude Code (abonnement), installée hors de /home, avec le jeton donné
# par `claude setup-token`. PRINTR_CLAUDE_BACKEND impose api ou cli (auto par défaut).
#PRINTR_CLAUDE_CLI=/usr/local/bin/claude
#CLAUDE_CODE_OAUTH_TOKEN=
#PRINTR_CLAUDE_BACKEND=auto

# Imprimante USB (lien créé par la règle udev)…
PRINTR_DEVICE=/dev/tm88
# … ou imprimante réseau (port RAW 9100), prioritaire si définie.
#PRINTR_TCP=192.168.1.50:9100

# Impressions permises par personne et par heure (0 : sans limite ; planifications non comptées).
#PRINTR_MAX_TICKETS_PER_HOUR=20

# Imprimante absente : les tickets attendent son retour, au plus tant d'heures (12 par défaut).
#PRINTR_QUEUE_HOURS=12

# Nouvelle version : vérifiée sur GitHub et signalée à l'administrateur dans l'appli. Rien n'est
# téléchargé ni installé tout seul. « off » : aucun contact avec GitHub.
#PRINTR_UPDATE_CHECK=off
# Minutes entre deux vérifications (1440, une par jour, par défaut ; 5 au minimum).
#PRINTR_UPDATE_INTERVAL=1440

# Adresse d'écoute de l'interface web.
PRINTR_LISTEN=0.0.0.0:8080
